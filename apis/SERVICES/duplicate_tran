    async getIncomeTransactionSum(req, res) {
        try {
            // Define the required slugs including the new ones
            const requiredSlugs = [
                'direct_income', 
                'reward_income', 
                'royality_income',
                'roi_income',
                'roi_level_income'
            ];
    
            // Fetch wallets with wallet_type='income' and status=1, and get the slugs
            const wallets = await Wallets.find({
                wallet_type: 'income',
                status: 1,
                slug: { $in: requiredSlugs }
            }, 'slug');
    
            const walletSlugs = wallets.map(wallet => wallet.slug);
    
            // Fetch transactions with source matching the slugs and status=1
            const transactions = await Transaction.find({
                source: { $in: walletSlugs },
                status: 1
            });
    
            // Calculate the sum of amounts
            const totalSum = transactions.reduce((sum, transaction) => sum + transaction.amount, 0);
    
            res.status(200).json({
                success: true,
                totalSum
            });
        } catch (error) {
            console.log(error);
            res.status(500).json({ success: false, message: error.message });
        }
    }
    
    

