const nodemailer = require('nodemailer');
const ejs = require('ejs');
const path = require('path');

const TEMPLETE_DIR = path.join(__dirname, '../templete');

function publicApiBase() {
    const fromEnv =
        process.env.PUBLIC_API_URL ||
        process.env.API_PUBLIC_URL ||
        process.env.APP_URL ||
        '';
    if (fromEnv) return String(fromEnv).replace(/\/$/, '');
    return 'https://apis.arogyagreenlife.com';
}

async function loadSiteSocial() {
    try {
        const WebsiteContent = require('../MODALS/WebsiteContent');
        const doc = await WebsiteContent.getOrCreate();
        const raw = doc.socialLinks?.toObject?.() || doc.socialLinks || {};
        return {
            facebook: raw.facebook || '',
            instagram: raw.instagram || '',
            youtube: raw.youtube || '',
            twitter: raw.twitter || '',
            linkedin: raw.linkedin || '',
            google: raw.google || '',
            whatsapp: raw.whatsapp || '',
        };
    } catch (_) {
        return {};
    }
}

class MailerService {
    getTransporter() {
        const port = Number(process.env.SMTP_PORT) || 465;
        if (!this._transporter || this._smtpKey !== `${process.env.SMTP_HOST}:${port}:${process.env.SMTP_USER}`) {
            this._smtpKey = `${process.env.SMTP_HOST}:${port}:${process.env.SMTP_USER}`;
            // AVG/other mail shields often MITM SMTP and break Node cert verify.
            const rejectUnauthorized =
                String(process.env.SMTP_TLS_REJECT_UNAUTHORIZED || 'true').toLowerCase() !== 'false';
            this._transporter = nodemailer.createTransport({
                host: process.env.SMTP_HOST,
                port,
                secure: port === 465,
                auth: {
                    user: process.env.SMTP_USER,
                    pass: process.env.SMTP_PASS,
                },
                tls: { rejectUnauthorized },
                greetingTimeout: 30000,
            });
        }
        return this._transporter;
    }

    /**
     * @param {string} to
     * @param {string} subject
     * @param {string} template - ejs basename without extension under apis/templete/
     * @param {object} data
     * @param {Array} [attachments] - nodemailer attachments
     */
    async sendMail(to, subject, template, data = {}, attachments) {
        if (!to) {
            throw new Error('Recipient email is required');
        }
        if (!process.env.SMTP_HOST || !process.env.SMTP_USER || !process.env.SMTP_PASS) {
            throw new Error('SMTP is not configured in environment');
        }

        const socialLinks = data.socialLinks || (await loadSiteSocial());
        const socialIconBase = `${publicApiBase()}/templete/assets/social`;
        const logoPathJpg = path.join(TEMPLETE_DIR, 'assets/brand/logo.jpg');
        const logoPathPng = path.join(TEMPLETE_DIR, 'assets/brand/logo.png');
        const fs = require('fs');
        const logoFile = fs.existsSync(logoPathJpg)
            ? logoPathJpg
            : fs.existsSync(logoPathPng)
              ? logoPathPng
              : null;
        const logoFilename = logoFile ? path.basename(logoFile) : 'logo.jpg';
        const logoUrl = `${publicApiBase()}/templete/assets/brand/${logoFilename}`;
        const logoCid = 'arogyagreenlife-logo';

        const html = await ejs.renderFile(
            path.join(TEMPLETE_DIR, `${template}.ejs`),
            {
                ...data,
                socialLinks,
                socialIconBase,
                logoUrl,
                logoCid: `cid:${logoCid}`,
            },
            { root: TEMPLETE_DIR }
        );

        const mailOptions = {
            from: process.env.FROM_EMAIL || process.env.SMTP_USER,
            to,
            subject,
            html,
            attachments: [],
        };
        if (logoFile) {
            mailOptions.attachments.push({
                filename: logoFilename,
                path: logoFile,
                cid: logoCid,
                contentDisposition: 'inline',
            });
        }
        if (attachments && attachments.length) {
            mailOptions.attachments.push(...attachments);
        }
        if (!mailOptions.attachments.length) {
            delete mailOptions.attachments;
        }

        await this.getTransporter().sendMail(mailOptions);
        console.log(`Email sent to ${to} successfully (${template}).`);
        return { success: true };
    }

    async verifySmtp() {
        if (!process.env.SMTP_HOST || !process.env.SMTP_USER || !process.env.SMTP_PASS) {
            throw new Error('SMTP is not configured in environment');
        }
        return this.getTransporter().verify();
    }
}

module.exports = new MailerService();
