<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to Arogya Green Life</title>
</head>
<body style="margin:0;padding:0;background:#e2e8f0;font-family:Arial,Helvetica,sans-serif;color:#111827;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#e2e8f0;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="560" cellspacing="0" cellpadding="0" style="max-width:560px;width:100%;background:#ffffff;border:1px solid #94a3b8;">
          <tr>
            <td style="padding:20px 24px;border-bottom:3px solid #0f766e;">
              <p style="margin:0;font-size:20px;font-weight:800;color:#0f766e;">Arogya Green Life</p>
              <p style="margin:6px 0 0;font-size:13px;color:#4b5563;">Welcome aboard</p>
            </td>
          </tr>
          <tr>
            <td style="padding:24px;">
              <p style="margin:0 0 12px;font-size:16px;">Hello <%= name || username %>,</p>
              <p style="margin:0 0 16px;font-size:14px;line-height:1.5;color:#374151;">
                Your <%= role || 'member' %> account has been created successfully. Keep these login details safe.
              </p>
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#ecfdf5;border:1px solid #99f6e4;">
                <tr>
                  <td style="padding:14px 16px;font-size:14px;line-height:1.7;">
                    <strong>Username:</strong> <%= username %><br />
                    <strong>Password:</strong> <%= password %><br />
                    <strong>Email:</strong> <%= email %>
                  </td>
                </tr>
              </table>
              <p style="margin:16px 0 0;font-size:13px;color:#4b5563;line-height:1.5;">
                For security, please change your password after your first login.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:14px 24px;background:#f8fafc;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b;">
              &copy; Arogya Green Life. This is an automated message.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
