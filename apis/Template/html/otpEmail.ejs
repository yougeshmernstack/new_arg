<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>OTP Verification</title>
  <style>
    body { font-family: Arial, sans-serif; color: #333; }
    .container { width: 80%; margin: 0 auto; padding: 20px; border: 1px solid #ddd; }
    .header { font-size: 20px; margin-bottom: 10px; }
    .otp { font-size: 24px; font-weight: bold; color: #007bff; }
    .action { margin-top: 20px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">Your OTP for <%= action %></div>
    <p>Please use the following OTP to complete your <%= action %>:</p>
    <p class="otp"><%= otp %></p>
    <p>This OTP is valid for 10 minutes. Please do not share it with anyone.</p>
  </div>
</body>
</html>
